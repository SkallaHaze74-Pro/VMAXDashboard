      "status": "bt638_confirmed_as_drive_level"
    },
    {
      "signal": "odometerKm",
      "callback": "ControllerPartListener.onOdoInKm",
      "originalCommand": "258",
      "unit": "km",
      "mapping": {"channel": "1506", "offset": 0, "encoding": "u32be", "scale": 0.1},
      "status": "bt638_confirmed"
    },
    {
      "signal": "rpm",
      "callback": "ControllerPartListener.onRPM",
      "originalCommand": "259",
      "unit": "rpm",
      "mapping": {"channel": "1505", "offset": 8, "encoding": "u16be", "scale": 1.0},
      "status": "libble_known_verify_on_bt638"
