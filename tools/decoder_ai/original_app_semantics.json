    "class": "com.gpstuner.mapviewer.androidbase.bluetooth.manager.HyenaSDKManager",
    "sdk": "io.hylink.hbp / libble-sdk-native-lib.so",
    "note": "Semantics are taken from the original app listeners. Byte mappings are only marked confirmed when independently matched to BT638/libble parser data. First real ride on 2026-08-13 disproved 150D as a second current-speed source."
  },
  "signals": [
